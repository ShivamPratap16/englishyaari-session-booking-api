{
  "info": {
    "name": "EnglishYaari - Session Booking API",
    "description": "Run the whole collection with the Collection Runner (or run \"Happy path\" top-to-bottom, then \"Error cases\"). IDs are captured into collection variables automatically. Change baseUrl if the server is not on http://localhost:4000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "teacherId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "dateTimestamp",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "teacherEmail",
      "value": ""
    },
    {
      "key": "startTime",
      "value": ""
    },
    {
      "key": "endTime",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Create Teacher (helper)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('teacherEmail', 'teacher.' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('teacherId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/teachers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teachers"
              ]
            },
            "description": "Helper endpoint so sessions can be created. Not one of the 6 required APIs.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Anita Sharma\",\n  \"email\": \"{{teacherEmail}}\",\n  \"specialization\": \"Spoken English\",\n  \"experience\": 6\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "API 1 - Create User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('userEmail', 'user.' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('User has id and timestamps', () => { pm.expect(pm.response.json().data._id).to.be.a('string'); pm.expect(pm.response.json().data.createdAt).to.be.a('string'); });",
                  "pm.collectionVariables.set('userId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Shivam Pratap Raj\",\n  \"email\": \"{{userEmail}}\",\n  \"phone\": \"+919876543210\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "API 2 - Create Session",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Random 1-hour slot 1-3 days ahead so repeated runs do not overlap.",
                  "const start = new Date(Date.now() + (24 + Math.floor(Math.random() * 48)) * 3600e3);",
                  "start.setUTCMinutes(0, 0, 0);",
                  "const end = new Date(start.getTime() + 60 * 60e3);",
                  "pm.collectionVariables.set('startTime', start.toISOString());",
                  "pm.collectionVariables.set('endTime', end.toISOString());",
                  "pm.collectionVariables.set('dateTimestamp', String(start.getTime()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Default status is AVAILABLE', () => pm.expect(pm.response.json().data.status).to.eql('AVAILABLE'));",
                  "pm.collectionVariables.set('sessionId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions"
              ]
            },
            "description": "startTime / endTime accept ISO 8601 strings or epoch milliseconds. endTime must be greater than startTime.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "API 3 - Available Sessions by date",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Contains the created session', () => pm.expect(pm.response.json().data.sessions.map(s => s._id)).to.include(pm.collectionVariables.get('sessionId')));",
                  "pm.test('All sessions are AVAILABLE', () => pm.response.json().data.sessions.forEach(s => pm.expect(s.status).to.eql('AVAILABLE')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/available?dateTimestamp={{dateTimestamp}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "available"
              ],
              "query": [
                {
                  "key": "dateTimestamp",
                  "value": "{{dateTimestamp}}"
                }
              ]
            },
            "description": "dateTimestamp = any Unix timestamp (ms or seconds) within the target day. The day is resolved in APP_TIMEZONE (default Asia/Kolkata). Implemented with an aggregation pipeline."
          }
        },
        {
          "name": "API 4 - Book Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('BOOKED and linked to user', () => { pm.expect(pm.response.json().data.status).to.eql('BOOKED'); pm.expect(pm.response.json().data.userId).to.eql(pm.collectionVariables.get('userId')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/book",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{sessionId}}",
                "book"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "API 6 - User Sessions (before completion)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Session is in upcomingSessions', () => pm.expect(pm.response.json().data.upcomingSessions.map(s => s._id)).to.include(pm.collectionVariables.get('sessionId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "sessions"
              ]
            },
            "description": "Implemented with an aggregation pipeline. upcomingSessions = BOOKED, completedSessions = COMPLETED."
          }
        },
        {
          "name": "API 5 - Mark Session Complete",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('COMPLETED with completedAt', () => { pm.expect(pm.response.json().data.status).to.eql('COMPLETED'); pm.expect(pm.response.json().data.completedAt).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{sessionId}}",
                "complete"
              ]
            }
          }
        },
        {
          "name": "API 6 - User Sessions (after completion)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Session moved to completedSessions', () => { pm.expect(pm.response.json().data.completedSessions.map(s => s._id)).to.include(pm.collectionVariables.get('sessionId')); pm.expect(pm.response.json().data.upcomingSessions.map(s => s._id)).to.not.include(pm.collectionVariables.get('sessionId')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "sessions"
              ]
            }
          }
        }
      ]
    },
