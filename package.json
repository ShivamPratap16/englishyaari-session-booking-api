{
  "name": "englishyaari-session-booking-api",
  "version": "1.0.0",
  "description": "Session booking REST API - Node.js, TypeScript, Express, MongoDB, Mongoose",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
